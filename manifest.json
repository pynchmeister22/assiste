{
    "manifest_version": 3,
    "name": "Mongtro",
    "version": "2.0",
    "description": "Integrated AI interview assistant with context-aware responses",
    "permissions": [
      "storage",
      "activeTab",
      "scripting",
      "tabCapture"
    ],
    "host_permissions": [
      "https://*/*",
      "http://localhost:*/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_icon": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
      },
      "default_popup": "popup.html"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": [
          "config.js",
          "utils/constants.js",
          "utils/crypto.js",
          "authService.js",
          "aiService.js",
          "audioService.js",
          "whisperService.js",
          "captionService.js",
          "content.js",
          "contentScript.js"
        ],
        "css": ["contentStyle.css"],
        "run_at": "document_idle"
      }
    ],
    "icons": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "web_accessible_resources": [
      {
        "resources": [
          "aiService.js",
          "assistantUIStyle.css"
        ],
        "matches": ["<all_urls>"]
      }
    ]
}